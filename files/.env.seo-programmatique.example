# Config du module SEO programmatique
# Copier ces variables dans .env.local ou dans le .env du projet cible.
# Ne jamais mettre une vraie cle API dans une archive partagee.

CLAUDE_API_KEY=sk-ant-xxxx

# Modele par defaut utilise par le module.
CLAUDE_MODEL=claude-sonnet-4-6

# Modeles disponibles dans les boutons/admin.
CLAUDE_MODEL_SONNET=claude-sonnet-4-6
CLAUDE_MODEL_SONNET_5=claude-sonnet-5
CLAUDE_MODEL_OPUS=claude-opus-4-8
CLAUDE_MODEL_FABLE=claude-fable-5

# Modele premium utilise en mode Auto pour les seeds prioritaires.
CLAUDE_MODEL_PREMIUM=claude-opus-4-8

# Limites de sortie.
CLAUDE_MAX_TOKENS_SONNET=7000
CLAUDE_MAX_TOKENS_OPUS=9000
CLAUDE_MAX_TOKENS_FABLE=9000
CLAUDE_MAX_TOKENS_DEFAULT=7000

# Timeout des appels Claude, en secondes.
CLAUDE_TIMEOUT_SECONDS=180
